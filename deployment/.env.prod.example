# ==============================================================================
# Production Environment Template (.env.prod.example)
# Copy to deployment/.env.prod and set real credentials
# ==============================================================================
ENVIRONMENT=production

# --- PostgreSQL / TimescaleDB (Production Instance) ---
POSTGRES_USER=aqua_prod
POSTGRES_PASSWORD=replace_with_strong_unique_prod_postgres_password
POSTGRES_DB=aquadb_prod
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://aqua_prod:replace_with_strong_unique_prod_postgres_password@postgres-db:5432/aquadb_prod

# --- Network & Service Port Mappings ---
API_PORT=8000
MQTT_PORT=1883
REDIS_HOST_PORT=6379

# --- Security / JWT Tokens ---
JWT_SECRET=replace_with_min_32_chars_random_prod_jwt_secret
JWT_SECRET_KEY=replace_with_min_32_chars_random_prod_jwt_secret
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# --- CORS Settings ---
CORS_ORIGINS=["https://app.aquaos.com","http://localhost:3000"]

# --- Mosquitto MQTT Broker ---
MQTT_BROKER_HOST=mqtt-broker
MQTT_BROKER_PORT=1883
MQTT_USERNAME=ingest
MQTT_PASSWORD=replace_with_strong_unique_prod_mqtt_password
MQTT_SIMULATOR_PASSWORD=replace_with_strong_unique_prod_sim_password
MQTT_TELEMETRY_TOPIC=aqua/devices/+/telemetry
MQTT_SHARED_GROUP=ingest

# --- Redis Cache / Broker ---
REDIS_HOST=redis
REDIS_PORT=6379
