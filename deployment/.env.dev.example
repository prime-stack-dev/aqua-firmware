# ==============================================================================
# Development Environment Template (.env.dev.example)
# Copy to deployment/.env.dev and set real credentials
# ==============================================================================
ENVIRONMENT=development

# --- PostgreSQL / TimescaleDB (Dev Instance) ---
POSTGRES_USER=aqua_dev
POSTGRES_PASSWORD=replace_with_secure_dev_postgres_password
POSTGRES_DB=aquadb_dev
POSTGRES_PORT=5433
DATABASE_URL=postgresql+asyncpg://aqua_dev:replace_with_secure_dev_postgres_password@postgres-db:5432/aquadb_dev

# --- Network & Service Port Mappings ---
API_PORT=8001
MQTT_PORT=1884
REDIS_HOST_PORT=6380

# --- Security / JWT Tokens ---
JWT_SECRET=replace_with_min_32_chars_random_jwt_secret
JWT_SECRET_KEY=replace_with_min_32_chars_random_jwt_secret
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=30

# --- CORS Settings ---
CORS_ORIGINS=["http://localhost:3000","http://localhost:8001"]

# --- Mosquitto MQTT Broker ---
MQTT_BROKER_HOST=mqtt-broker
MQTT_BROKER_PORT=1883
MQTT_USERNAME=ingest
MQTT_PASSWORD=replace_with_secure_dev_mqtt_password
MQTT_SIMULATOR_PASSWORD=replace_with_secure_dev_simulator_password
MQTT_TELEMETRY_TOPIC=aqua/devices/+/telemetry
MQTT_SHARED_GROUP=ingest

# --- Redis Cache / Broker ---
REDIS_HOST=redis
REDIS_PORT=6379
