# The ingest worker reads all device telemetry and can perform healthchecks.
user ingest
topic read aqua/devices/+/telemetry
topic read $share/ingest/aqua/devices/+/telemetry
topic read $SYS/#
topic readwrite aqua/healthcheck

# Development simulator only. Publishes as any device.
user simulator
topic write aqua/devices/+/telemetry

# A real device logs in with its serial and can publish only to its own topic.
pattern write aqua/devices/%u/telemetry
