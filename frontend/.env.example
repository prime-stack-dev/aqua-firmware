# Frontend settings. Copy to frontend/.env.local.
# Anything starting with NEXT_PUBLIC_ is visible in the browser,
# so never put passwords or secrets in this file.

NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Set to true to skip login and show sample data without the backend.
# Only works with "npm run dev". Production builds always ignore it.
NEXT_PUBLIC_BYPASS_LOGIN=false
