# Backend settings. Copy to backend/.env and replace every "change-me" value.
# Docker also uses this file for PostgreSQL and Mosquitto.

ENVIRONMENT=development

# --- PostgreSQL ---
POSTGRES_USER=aqua
POSTGRES_PASSWORD=change-me
POSTGRES_DB=aquadb

# Must use the same user, password and database as above.
# Running without Docker? Replace postgres-db with localhost.
DATABASE_URL=postgresql+asyncpg://aqua:change-me@postgres-db:5432/aquadb

# --- Login tokens ---
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters

# --- Websites allowed to call the API ---
CORS_ORIGINS=["http://localhost:3000"]

# --- Mosquitto (MQTT broker) ---
# Running without Docker? Replace mqtt-broker with localhost.
MQTT_BROKER_HOST=mqtt-broker
MQTT_BROKER_PORT=1883
MQTT_USERNAME=ingest
MQTT_PASSWORD=change-me
MQTT_SIMULATOR_PASSWORD=change-me
